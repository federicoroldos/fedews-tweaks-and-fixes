root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{csproj,props,xml}]
indent_style = space
indent_size = 2

[*.{md,yml,yaml,svg}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

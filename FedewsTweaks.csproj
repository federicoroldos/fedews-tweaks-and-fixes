<Project Sdk="Microsoft.NET.Sdk">

  <!-- Optional, not uploaded: local.props can set GameDir to where your game is installed -->
  <Import Project="local.props" Condition="Exists('local.props')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>FedewsTweaks</AssemblyName>
    <RootNamespace>FedewsTweaks</RootNamespace>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <!-- Compile against the exact runtime libraries the game ships with -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS1701;CS1702;MSB3270;MSB3277</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II</GameDir>
    <ManagedDir>$(GameDir)\Cities2_Data\Managed</ManagedDir>
    <DeployDir>$(USERPROFILE)\AppData\LocalLow\Colossal Order\Cities Skylines II\Mods\FedewsTweaks</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(ManagedDir)\*.dll" Private="false" />
    <Reference Include="lib\0Harmony.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="Build">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="lib\0Harmony.dll" DestinationFolder="$(DeployDir)" />
    <Message Importance="high" Text="Deployed to $(DeployDir)" />
  </Target>

</Project>

